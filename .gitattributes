# Force LF line endings for shell scripts and text files on all platforms
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Python scripts
*.py text eol=lf

# Web / config files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf

# Binaries — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary

# LUC media rate card is sha256-pinned across two repos (see
# backend/uef-gateway/src/luc/__tests__/media-ctg.drift.test.ts and, in
# BoomerAng9/broad-cast-app, lib/luc/__tests__/rate-card-drift.test.ts).
# The pin hashes literal bytes, so line endings must be identical on every
# platform or the guard fails on Windows while passing in Linux CI.
backend/uef-gateway/src/luc/media-rate-card.json -text eol=lf
